# MDM Platform — copy values into backend/.env

APP_NAME="MDM Platform"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mdm_platform
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MDM engine: nano (testing) | custom (production)
MDM_ENGINE=nano
NANO_MDM_BASE_URL=http://127.0.0.1:9000
NANO_MDM_API_KEY=
NANO_MDM_TIMEOUT=30
CUSTOM_MDM_BASE_URL=http://127.0.0.1:9001
CUSTOM_MDM_API_KEY=
CUSTOM_MDM_TIMEOUT=30
MDM_COMMAND_TIMEOUT=300

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
