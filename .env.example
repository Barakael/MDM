# MDM Platform — copy values into backend/.env
#
# Lab (PC LAN IP): set APP_URL / NANO_MDM_PUBLIC_URL / NANO_SCEP_URL / VITE_API_URL
#   to http://YOUR_LAN_IP:port (or ngrok HTTPS).
# Production: flip those to https://your-domain and create new enrollment profiles.

APP_NAME="MDM Platform"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mdm_platform
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# MDM engine: nano (testing) | custom (production)
MDM_ENGINE=nano

# Laravel → NanoMDM API (server-to-server; can stay localhost)
NANO_MDM_BASE_URL=http://127.0.0.1:9000
NANO_MDM_API_KEY=nanomdm
NANO_MDM_TIMEOUT=30

# Device-facing URLs (LAN IP / ngrok today → HTTPS domain after deploy)
NANO_MDM_PUBLIC_URL=http://127.0.0.1:9000
NANO_SCEP_URL=http://127.0.0.1:8080/scep
NANO_SCEP_CHALLENGE=nanomdm
NANO_MDM_TOPIC=

# NanoMDM → Laravel webhook (start-nanomdm.sh reads the same vars)
NANO_MDM_WEBHOOK_URL=http://127.0.0.1:8000/api/v1/webhooks/nanomdm
NANO_MDM_WEBHOOK_SECRET=

# Fallback org when enrollment_token is missing from ServerURL query
NANO_MDM_DEFAULT_ORGANIZATION_ID=1

CUSTOM_MDM_BASE_URL=http://127.0.0.1:9001
CUSTOM_MDM_API_KEY=
CUSTOM_MDM_TIMEOUT=30
MDM_COMMAND_TIMEOUT=300

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
