[Unit]
Description=MDM Platform Laravel (php artisan serve)
After=network.target redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/mdm.wayda.co.tz/backend
Environment=APP_ENV=production
ExecStart=/usr/bin/php artisan serve --host=127.0.0.1 --port=8010
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
